<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/book_cover_size_large"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="6dp">

    <ImageView
        android:id="@+id/card_cover"
        android:layout_width="@dimen/book_cover_size_large"
        android:layout_height="@dimen/book_cover_size_large"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_default_cover" />

    <ProgressBar
        android:id="@+id/card_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:visibility="gone"
        tools:progress="40"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="Book title that might wrap to two lines" />

    <TextView
        android:id="@+id/card_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="Author name" />

</LinearLayout>
